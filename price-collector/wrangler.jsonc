{
  "name": "aion2-price-collector",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "PRICE_HISTORY",
      "database_name": "aion2-price-history",
      "database_id": "0fbba349-6387-4183-b738-d19c3bde5724"
    }
  ],
  "vars": {
    "SERVER_IDS": "11303",
    "RETENTION_DAYS": "30"
  }
}
